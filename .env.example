# Copy to `.env` (gitignored) and fill in from the Knock dashboard, Development environment.

# Knock secret API key (sk_test_…). Server only; never expose to the browser.
KNOCK_API_KEY=
# Knock public API key (pk_test_…). Safe for the browser.
KNOCK_PUBLIC_API_KEY=
# UUID of the in-app feed channel (Integrations > Channels). Used by KnockFeedProvider.
KNOCK_FEED_CHANNEL_ID=
